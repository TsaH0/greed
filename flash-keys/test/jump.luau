local greed = require("@greed")
local test = require("@greed/test")
local flash = require("@flash-keys")

local function setup(t: test.TestContext, text: string)
	t:buffer(text)
	greed.mode.set("flash")
end

test("labels go on each occurrence on screen, nearest first", function(t)
	setup(t, "x1 x2 |x3 x4")
	local targets = flash.jump.targets(greed.view(), greed.view():cursor(), "x")
	assert(#targets == 4, tostring(#targets))
	assert(targets[1].pos == 6 and targets[1].label == "a", greed.json.encode(targets))
	assert(targets[2].pos == 3 and targets[2].label == "b", greed.json.encode(targets))
end)

test("ctrl-m, the character, then its label jumps there", function(t)
	setup(t, "x1 x2 |x3 x4")
	-- Nearest first, the earlier on a tie: x3 is a, x2 b, x4 c, x1 d.
	t:keys("ctrl-m x c")
	t:expect("x1 x2 x3 |x4")
	setup(t, "x1 x2 |x3 x4")
	t:keys("ctrl-m x b")
	t:expect("x1 |x2 x3 x4")
	setup(t, "|a.b.c")
	t:keys("ctrl-m . b")
	t:expect("a.b|.c")
end)

test("esc or alt-m while choosing cancels, and the labels go", function(t)
	setup(t, "x1 x2 |x3")
	t:keys("ctrl-m x esc")
	t:expect("x1 x2 |x3")
	t:keys("ctrl-m x alt-m")
	t:expect("x1 x2 |x3")
	assert(#greed.view():buffer():decorations("flash-keys-jump") == 0, "labels cleared")
end)

test("a label that isn't one cancels", function(t)
	setup(t, "x1 |x2")
	t:keys("ctrl-m x z")
	t:expect("x1 |x2")
end)

test("alt-m afterwards goes back to where the jump started", function(t)
	setup(t, "x1 x2 |x3")
	t:keys("ctrl-m x c")
	t:expect("|x1 x2 x3")
	t:keys("alt-m")
	t:expect("x1 x2 |x3")
end)

test("ctrl-M jumps extending the selection", function(t)
	setup(t, "|ab x1 x2")
	t:keys("ctrl-M x b")
	t:expect("^ab x1 |x2")
	setup(t, "|ab x1 x2")
	t:keys("ctrl-m x b")
	t:expect("ab x1 |x2")
end)

test("many occurrences get two-letter labels", function(t)
	setup(t, "|" .. string.rep("x", 30))
	local targets = flash.jump.targets(greed.view(), 0, "x")
	assert(#targets[1].label == 2, targets[1].label)
	t:keys("ctrl-m x a b")
	t:expect("x|" .. string.rep("x", 29))
end)

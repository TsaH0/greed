local greed = require("@greed")
local test = require("@greed/test")

local function check(t: test.TestContext, before: string, keys: string, after: string)
	t:buffer(before)
	greed.mode.set("flash")
	t:keys(keys)
	t:expect(after)
end

test("ctrl-m then a pair's key wraps the selection, the pair selected with it", function(t)
	check(t, "a ^b| c", "ctrl-m ctrl-b", "a ^(b)| c")
	check(t, "a ^b| c", "ctrl-m b", "a ^(b)| c")
	check(t, "a ^b| c", "ctrl-m ctrl-r", "a ^[b]| c")
	check(t, "a ^b| c", "ctrl-m ctrl-c", "a ^{b}| c")
	check(t, "a ^b| c", "ctrl-m ctrl-a", "a ^<b>| c")
	check(t, "a ^b| c", "ctrl-m ctrl-q", 'a ^"b"| c')
	check(t, "a ^b| c", "ctrl-m '", "a ^'b'| c")
	check(t, "a ^b| c", "ctrl-m `", "a ^`b`| c")
end)

test("with nothing selected, ctrl-m wraps the word at the cursor", function(t)
	check(t, "say he|llo now", "ctrl-m ctrl-q", 'say ^"hello"| now')
	check(t, "say hello| now", "ctrl-m ctrl-b", "say ^(hello)| now")
end)

test("ctrl-m wraps every selection", function(t)
	check(t, "^a| ^b|", "ctrl-m ctrl-r", "^[a]| ^[b]|")
	check(t, "x ^ab|\ny ^cd|", "ctrl-m ctrl-q", 'x ^"ab"|\ny ^"cd"|')
end)

test("alt-m then a pair's key takes the pair around the cursor away", function(t)
	check(t, "f(a|b) c", "alt-m alt-b", "fa|b c")
	check(t, "f(a|b) c", "alt-m b", "fa|b c")
	check(t, "x [a|b] y", "alt-m alt-r", "x a|b y")
	check(t, 'say "hi|" now', "alt-m alt-q", "say hi| now")
	check(t, "{ (a|) }", "alt-m alt-n", "{ a| }")
	check(t, "{ (a|) }", "alt-m alt-c", " (a|) ")
end)

test("alt-m takes the nearest pair when the cursor is in none", function(t)
	check(t, "|foo(a, b) x", "alt-m alt-b", "|fooa, b x")
end)

test("ctrl-m ctrl-s swaps a pair: the old one's key, then the new one's", function(t)
	check(t, "f(a|b) c", "ctrl-m ctrl-s b r", "f[a|b] c")
	check(t, "f(a|b) c", "ctrl-m s ( {", "f{a|b} c")
	check(t, 'say "hi|"', "ctrl-m ctrl-s q '", "say 'hi|'")
end)

test("surround is one step to undo", function(t)
	check(t, "a ^b| c", "ctrl-m ctrl-b ctrl-z", "a ^b| c")
	check(t, "f(a|b) c", "alt-m alt-b ctrl-z", "f(a|b) c")
end)

test("the old surround keys still work", function(t)
	check(t, "a ^b| c", "ctrl-T a (", "a ^(b)| c")
	check(t, "a (b|) c", "ctrl-c e d (", "a b| c")
end)

local greed = require("@greed")
local test = require("@greed/test")

local function check(t: test.TestContext, before: string, keys: string, after: string)
	t:buffer(before)
	greed.mode.set("flash")
	t:keys(keys)
	t:expect(after)
end

test("C-x 3 and C-x 2 split, ctrl-p and alt-p go round the panes, C-x 0 closes one", function(t)
	t:buffer("|abc")
	greed.mode.set("flash")
	local first = greed.view():id()
	t:keys("ctrl-x 3")
	local second = greed.view():id()
	assert(second ~= first, "split")
	t:keys("ctrl-x 2")
	local third = greed.view():id()
	assert(#greed.tab.current().panes == 3, tostring(#greed.tab.current().panes))
	t:keys("ctrl-p")
	assert(greed.view():id() ~= third, "next pane")
	t:keys("alt-p")
	assert(greed.view():id() == third, "previous pane comes back")
	t:keys("ctrl-x 0")
	assert(#greed.tab.current().panes == 2, "closed")
end)

test("ctrl-b and alt-b go through the open files", function(t)
	local dir = t:tempdir({ ["a.txt"] = "a", ["b.txt"] = "b" })
	t:open(dir .. "/a.txt")
	t:open(dir .. "/b.txt")
	greed.mode.set("flash")
	local function name(): string
		return string.match(greed.view():buffer():path() or "", "[^/]+$") or ""
	end
	local start = name()
	t:keys("ctrl-b")
	assert(name() ~= start, "next file")
	t:keys("alt-b")
	assert(name() == start, "back again")
end)

test("C-x C-s saves", function(t)
	local dir = t:tempdir({ ["a.txt"] = "a" })
	t:open(dir .. "/a.txt")
	greed.mode.set("flash")
	t:keys("alt-a x ctrl-x ctrl-s")
	assert(not greed.view():buffer():modified(), "saved")
end)

test("ctrl-- folds the block and alt-- opens it", function(t)
	t:buffer("fn a() {\n    |x();\n    y();\n}\n")
	greed.view():buffer():set_language("rust")
	greed.mode.set("flash")
	t:keys("ctrl--")
	assert(#greed.view():hidden_lines() == 1, "folded")
	t:keys("alt--")
	assert(#greed.view():hidden_lines() == 0, "open")
end)

test("C-c e . repeats the last change", function(t)
	check(t, "|a\nb", "x ctrl-j ctrl-a ctrl-c e .", "xa\nx|b")
end)

test("C-c e + and - change the number at the cursor", function(t)
	check(t, "n = |41", "ctrl-c e +", "n = ^42|")
	check(t, "n = |41", "ctrl-c e -", "n = ^40|")
end)

test('C-c e " picks a register for the next copy, and C-c e i inserts it', function(t)
	check(t, "^ab| cd", 'ctrl-c e " q ctrl-c e y alt-S alt-a ctrl-c e i q', "ab cdab|")
end)

test("C-c e ; comments the line, again uncomments it", function(t)
	t:buffer("a|b")
	greed.view():buffer():set_language("rust")
	greed.mode.set("flash")
	t:keys("ctrl-c e ; ctrl-c e ;")
	t:expect("a|b")
end)

test("the help and command pickers open from C-c h and C-c w", function(t)
	for _, keys in { "ctrl-c w c", "ctrl-c h c", "ctrl-x ctrl-f" } do
		t:buffer("|abc")
		greed.mode.set("flash")
		t:keys(keys)
		assert(greed.view():buffer():kind() == "picker", keys)
		t:keys("esc")
	end
end)

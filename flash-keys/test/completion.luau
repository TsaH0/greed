local greed = require("@greed")
local test = require("@greed/test")

-- A menu of the words in the buffer that start with "ap", from the lsp
-- plugin's own source of words in open files: apple, then apricot.
local function open(t: test.TestContext, text: string?)
	t:buffer(text or "apple apricot\nx |")
	greed.mode.set("flash")
	t:keys("a p")
	t:run("completion-ask")
	assert(#t:floats() == 1, "the menu is open")
	t:expect_mode("completion-flash")
end

test("tab and shift-tab go through the menu, enter puts the item in", function(t)
	-- apple comes first, chosen as the menu opens.
	open(t)
	t:keys("enter")
	t:expect("apple apricot\nx apple|")
	open(t)
	t:keys("tab enter")
	t:expect("apple apricot\nx apricot|")
	open(t)
	t:keys("tab shift-tab enter")
	t:expect("apple apricot\nx apple|")
	t:expect_mode("flash")
end)

test("typing keeps the menu open and narrows it", function(t)
	open(t)
	t:keys("r")
	assert(#t:floats() == 1, "still open")
	t:keys("tab enter")
	t:expect("apple apricot\nx apricot|")
end)

test("flash's other keys close the menu and do what they always do", function(t)
	open(t)
	t:keys("ctrl-a")
	assert(#t:floats() == 0, "ctrl-a closed it")
	t:expect_mode("flash")
	t:expect("apple apricot\n|x ap^")
	open(t)
	t:keys("ctrl-h")
	assert(#t:floats() == 0, "ctrl-h closed it")
	t:expect("apple apricot\nx a|p")
	open(t)
	t:keys("ctrl-g g")
	assert(#t:floats() == 0, "ctrl-g g closed it")
	t:expect("|apple apricot\nx ap")
	open(t, "apple apricot\nx | one")
	t:keys("ctrl-w")
	assert(#t:floats() == 0, "ctrl-w closed it")
	t:expect("apple apricot\nx ap ^one|")
end)

test("ctrl-n and ctrl-p are flash's, not the menu's", function(t)
	open(t)
	assert(greed.keymap.resolve("ctrl-n") == "flash-search-next", tostring(greed.keymap.resolve("ctrl-n")))
	assert(greed.keymap.resolve("ctrl-p") == "pane-next", tostring(greed.keymap.resolve("ctrl-p")))
	assert(greed.keymap.resolve("tab") == "completion-tab", tostring(greed.keymap.resolve("tab")))
	t:keys("ctrl-n")
	assert(#t:floats() == 0, "closed")
end)

test("esc closes the menu", function(t)
	open(t)
	t:keys("esc")
	assert(#t:floats() == 0, "closed")
	t:expect_mode("flash")
	t:expect("apple apricot\nx ap|")
end)

test("with no menu, tab is still tab", function(t)
	t:buffer("|x")
	greed.mode.set("flash")
	t:keys("tab")
	t:expect("    |x")
end)

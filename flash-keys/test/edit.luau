local greed = require("@greed")
local test = require("@greed/test")

local function check(t: test.TestContext, before: string, keys: string, after: string)
	t:buffer(before)
	greed.mode.set("flash")
	t:keys(keys)
	t:expect(after)
end

test("ctrl-d deletes forward, alt-d back, or the selection", function(t)
	check(t, "a|bc", "ctrl-d", "a|c")
	check(t, "a|bc", "alt-d", "|bc")
	check(t, "^ab|c", "ctrl-d", "|c")
end)

test("ctrl-u upper-cases the word at the cursor, alt-u lower-cases, both the selection", function(t)
	check(t, "one t|wo", "ctrl-u", "one TWO|")
	check(t, "ONE T|WO", "alt-u", "ONE two|")
	check(t, "^one| two", "ctrl-u", "^ONE| two")
end)

test("ctrl-\\ cycles lower, UPPER and Title, alt-\\ the other way", function(t)
	check(t, "wo|rd", "ctrl-\\", "WORD|")
	check(t, "WO|RD", "ctrl-\\", "Word|")
	check(t, "Wo|rd", "ctrl-\\", "word|")
	check(t, "wo|rd", "alt-\\", "Word|")
end)

test("ctrl-i indents, alt-i takes it off", function(t)
	check(t, "a|b", "ctrl-i", "    a|b")
	check(t, "    a|b", "alt-i", "a|b")
end)

test("ctrl-o opens a line below, alt-o above", function(t)
	check(t, "a|b\nc", "ctrl-o x", "ab\nx|\nc")
	check(t, "a\nb|c", "alt-o x", "a\nx|\nbc")
end)

test("ctrl-z undoes, alt-z redoes", function(t)
	check(t, "|", "a b ctrl-z", "|")
	check(t, "|", "a b ctrl-z alt-z", "ab|")
end)

test("ctrl-y pastes and alt-y takes the paste back, only while it's the last change", function(t)
	check(t, "^ab| c", "ctrl-c e y alt-S alt-a ctrl-y", "ab cab|")
	t:keys("alt-y")
	t:expect("ab c|")
	check(t, "^ab| c", "ctrl-c e y alt-S alt-a ctrl-y x alt-y", "ab cabx|")
end)

test("marks are set with ctrl-' and gone back to with alt-'", function(t)
	check(t, "a|bc def", "ctrl-' q alt-a alt-' q", "a|bc def")
	check(t, "a|bc def", "ctrl-g m q alt-a ctrl-g ' q", "a|bc def")
	-- They move with edits.
	check(t, "abc |def", "ctrl-' q ctrl-a x x alt-a alt-' q", "xxabc |def")
end)

test("ctrl-s adds the next match of the word as a selection, alt-s the previous", function(t)
	check(t, "a b |a c a", "ctrl-s", "a b ^a| c a")
	check(t, "a b |a c a", "ctrl-s ctrl-s", "a b ^a| c ^a|")
	check(t, "a b |a c a", "alt-s alt-s", "^a| b ^a| c a")
end)

test("multiple cursors: below, above, split, all and back to one", function(t)
	check(t, "a|b\ncd", "ctrl-c m j", "a|b\nc|d")
	check(t, "ab\nc|d", "ctrl-c m k", "a|b\nc|d")
	check(t, "^ab\ncd|", "ctrl-c m s", "^ab|\n^cd|")
	check(t, "|x y x", "ctrl-c m a", "^x| y ^x|")
	check(t, "|ab\n|cd", "ctrl-c m c", "|ab\ncd")
	check(t, "|ab\n|cd", "ctrl-c m x", "ab\n|cd")
	check(t, "|ab |cd", "ctrl-W x", "x|x|")
end)

test("ctrl-n and alt-n go to the next and previous match of the search", function(t)
	check(t, "|x a x", "ctrl-c s w", "x a ^x|")
	t:buffer("|a x b x c x")
	greed.mode.set("flash")
	t:keys("ctrl-/ x enter")
	t:expect("a ^x| b x c x")
	t:keys("ctrl-n")
	t:expect("a x b ^x| c x")
	t:keys("alt-n")
	t:expect("a ^x| b x c x")
end)

test("a search extends an active selection to the match", function(t)
	t:buffer("|a x b x")
	greed.mode.set("flash")
	t:keys("ctrl-/ x enter alt-S ctrl-a")
	t:expect("|a x b x")
	t:keys("ctrl-space ctrl-n")
	t:expect("^a x| b x")
end)

test("ctrl-r replaces the next match with what was asked for once", function(t)
	t:buffer("|a x b x c x")
	greed.mode.set("flash")
	t:keys("ctrl-/ x enter alt-S ctrl-a")
	t:keys("ctrl-r")
	t:type("Y")
	t:keys("enter")
	t:expect("a Y| b x c x")
	t:keys("ctrl-r")
	t:expect("a Y b Y| c x")
	t:keys("alt-a alt-r")
	t:expect("a Y b Y c |Y")
end)

test("ctrl-g l goes to the line typed, ctrl-g r by lines", function(t)
	t:buffer("|a\nb\nc\nd")
	greed.mode.set("flash")
	t:keys("ctrl-g l")
	t:type("3")
	t:keys("enter")
	t:expect("a\nb\n|c\nd")
	t:keys("ctrl-g r")
	t:type("-2")
	t:keys("enter")
	t:expect("|a\nb\nc\nd")
end)

test("comments, joins and moving lines in C-c e", function(t)
	t:buffer("a|b\ncd")
	greed.view():buffer():set_language("rust")
	greed.mode.set("flash")
	t:keys("ctrl-c e ;")
	t:expect("// a|b\ncd")
	check(t, "a|b\ncd", "ctrl-c e j", "a|b cd")
	check(t, "a|b\ncd", "ctrl-c e J", "cd\na|b")
end)

test("macros record and play through C-c e", function(t)
	check(t, "|ab\ncd", "ctrl-c e q ctrl-a x ctrl-j ctrl-c e q ctrl-c e @", "xab\nx|cd")
end)

local greed = require("@greed")
local test = require("@greed/test")

local function check(t: test.TestContext, before: string, keys: string, after: string)
	t:buffer(before)
	greed.mode.set("flash")
	t:keys(keys)
	t:expect(after)
end

test("ctrl-m selects inside brackets, alt-m around them", function(t)
	check(t, "x[a|b]y", "ctrl-m ctrl-r", "x[^ab|]y")
	check(t, "x[a|b]y", "alt-m alt-r", "x^[ab]|y")
	check(t, "f(a|b)", "ctrl-m ctrl-b", "f(^ab|)")
	check(t, "f(a|b)", "alt-m alt-b", "f^(ab)|")
	check(t, "{ a| }", "ctrl-m ctrl-c", "{^ a |}")
	check(t, "<a|b>", "ctrl-m ctrl-a", "<^ab|>")
end)

test("the key after ctrl-m or alt-m works without its modifier too", function(t)
	check(t, "x[a|b]y", "ctrl-m r", "x[^ab|]y")
	check(t, "x[a|b]y", "alt-m r", "x^[ab]|y")
end)

test("quotes take the innermost pair of any kind", function(t)
	check(t, [[say "a 'b|c' d"]], "ctrl-m ctrl-q", [[say "a '^bc|' d"]])
	check(t, [[say "a|b"]], "alt-m alt-q", [[say ^"ab"|]])
end)

test("words, lines and paragraphs", function(t)
	check(t, "one t|wo three", "ctrl-m ctrl-w", "one ^two| three")
	check(t, "a\n  b|c\nd", "ctrl-m ctrl-l", "a\n  ^bc|\nd")
	check(t, "a\n  b|c\nd", "alt-m alt-l", "a\n^  bc\n|d")
	check(t, "a\nb|\n\nc", "ctrl-m ctrl-p", "^a\nb|\n\nc")
end)

test("the nearest pair of brackets of any kind", function(t)
	check(t, "[(a|b)]", "ctrl-m ctrl-n", "[(^ab|)]")
	check(t, "[x (a) |y]", "alt-m alt-n", "^[x (a) y]|")
end)

test("a tag", function(t)
	check(t, "<p>hi|</p>", "ctrl-m ctrl-x", "<p>^hi|</p>")
	check(t, "<p>hi|</p>", "alt-m alt-x", "^<p>hi</p>|")
end)

test("an object's selection is carried on with shift", function(t)
	check(t, "f(a|b) c", "ctrl-m ctrl-b ctrl-L", "f(^ab)| c")
	check(t, "f(a|b) c", "ctrl-m ctrl-b ctrl-l", "f(ab)| c")
end)

test("each cursor gets its own object", function(t)
	check(t, "(a|) (b|)", "ctrl-m ctrl-b", "(^a|) (^b|)")
end)

test("outside any object, the next one on the line is taken, as Vim does", function(t)
	check(t, "|foo(a, b) x", "ctrl-m ctrl-b", "foo(^a, b|) x")
	check(t, "|foo(a, b) x", "alt-m alt-b", "foo^(a, b)| x")
	check(t, "|x = [1, 2]", "ctrl-m ctrl-r", "x = [^1, 2|]")
	check(t, "|if x { y }", "ctrl-m ctrl-c", "if x {^ y |}")
	check(t, '|say "hi" now', "ctrl-m ctrl-q", 'say "^hi|" now')
	check(t, "|say 'hi' now", "alt-m alt-q", "say ^'hi'| now")
	check(t, "|<p>hi</p>", "ctrl-m ctrl-x", "<p>^hi|</p>")
	check(t, "|f(a) [b]", "ctrl-m ctrl-n", "f(^a|) [b]")
end)

test("with none after it on the line, the nearest one before or after", function(t)
	check(t, "foo(a, b) x|", "ctrl-m ctrl-b", "foo(^a, b|) x")
	check(t, "(a)\n|\n\n\n(b)", "ctrl-m ctrl-b", "(^a|)\n\n\n\n(b)")
	check(t, "(a)\n\n\n|\n(b)", "ctrl-m ctrl-b", "(a)\n\n\n\n(^b|)")
	-- The next one on the line wins over a nearer one before.
	check(t, "(a)| x x x x (b)", "ctrl-m ctrl-b", "(a) x x x x (^b|)")
end)

test("inside an object, that one is still taken", function(t)
	check(t, "(a |b) (c)", "ctrl-m ctrl-b", "(^a b|) (c)")
end)

test("each cursor takes its own nearest object", function(t)
	check(t, "|f(a)\n|g(b)", "ctrl-m ctrl-b", "f(^a|)\ng(^b|)")
end)

test("functions come from the syntax tree, the next one if the cursor's in none", function(t)
	t:buffer("|// x\nfn a() {\n    1\n}\n")
	greed.view():buffer():set_language("rust")
	greed.mode.set("flash")
	t:keys("alt-m alt-f")
	t:expect("// x\n^fn a() {\n    1\n}|\n")
end)

test("ctrl-m W takes a WORD, d a number, i an indented block", function(t)
	check(t, "x #inc|lude y", "ctrl-m W", "x ^#include| y")
	check(t, "x #inc|lude y", "alt-m W", "x ^#include |y")
	check(t, "n = 4|2 + 1", "ctrl-m d", "n = ^42| + 1")
	check(t, "a:\n  b\n  c|\nd", "ctrl-m i", "a:\n^  b\n  c\n|d")
end)

test("ctrl-m g takes an argument, / a comment, t a type, from the syntax tree", function(t)
	t:buffer("fn a(x: u8, y|: u8) {}\n")
	greed.view():buffer():set_language("rust")
	greed.mode.set("flash")
	t:keys("ctrl-m g")
	t:expect("fn a(x: u8, ^y: u8|) {}\n")
	t:buffer("let x = 1; // a no|te\n")
	greed.view():buffer():set_language("rust")
	greed.mode.set("flash")
	t:keys("alt-m /")
	t:expect("let x = 1; ^// a note|\n")
	t:buffer("|fn a(x: u8) {}\n")
	greed.view():buffer():set_language("rust")
	greed.mode.set("flash")
	t:keys("ctrl-m g")
	t:expect("fn a(^x: u8|) {}\n")
end)

test("C-c i and C-c a select inside and around too, for terminals that send ctrl-m as enter", function(t)
	check(t, "f(a|b)", "ctrl-c i b", "f(^ab|)")
	check(t, "f(a|b)", "ctrl-c a b", "f^(ab)|")
	check(t, "one t|wo three", "ctrl-c i w", "one ^two| three")
end)

test("with no object around the cursor nothing changes", function(t)
	check(t, "a|b", "ctrl-m ctrl-b", "a|b")
end)

test("functions and syntax nodes come from the syntax tree", function(t)
	t:buffer("fn a() {\n    let x = 1|;\n}\nfn b() {}\n")
	greed.view():buffer():set_language("rust")
	greed.mode.set("flash")
	t:keys("alt-m alt-f")
	t:expect("^fn a() {\n    let x = 1;\n}|\nfn b() {}\n")
	t:buffer("fn a() { foo(ba|r) }")
	greed.view():buffer():set_language("rust")
	greed.mode.set("flash")
	t:keys("ctrl-m ctrl-o")
	t:expect("fn a() { foo(^bar|) }")
	t:keys("ctrl-[")
	t:expect("fn a() { foo^(bar)| }")
	t:keys("alt-[")
	t:expect("fn a() { foo(^bar|) }")
end)

test("surround adds, changes and deletes the pair around the selection", function(t)
	check(t, "a ^b| c", "ctrl-c e a (", "a ^(b)| c")
	check(t, "a (b|) c", "ctrl-c e r ( [", "a [b]| c")
	check(t, "a (b|) c", "ctrl-c e d (", "a b| c")
end)

local greed = require("@greed")
local test = require("@greed/test")

local function check(t: test.TestContext, before: string, keys: string, after: string)
	t:buffer(before)
	greed.mode.set("flash")
	t:keys(keys)
	t:expect(after)
end

test("ctrl-t selects inside brackets, alt-t around them", function(t)
	check(t, "x[a|b]y", "ctrl-t ctrl-b", "x[^ab|]y")
	check(t, "x[a|b]y", "alt-t alt-b", "x^[ab]|y")
	check(t, "f(a|b)", "ctrl-t ctrl-r", "f(^ab|)")
	check(t, "f(a|b)", "alt-t alt-r", "f^(ab)|")
	check(t, "{ a| }", "ctrl-t ctrl-c", "{^ a |}")
	check(t, "<a|b>", "ctrl-t ctrl-a", "<^ab|>")
end)

test("the key after ctrl-t or alt-t works without its modifier too", function(t)
	check(t, "x[a|b]y", "ctrl-t b", "x[^ab|]y")
	check(t, "x[a|b]y", "alt-t b", "x^[ab]|y")
end)

test("quotes take the innermost pair of any kind", function(t)
	check(t, [[say "a 'b|c' d"]], "ctrl-t ctrl-q", [[say "a '^bc|' d"]])
	check(t, [[say "a|b"]], "alt-t alt-q", [[say ^"ab"|]])
end)

test("words, lines and paragraphs", function(t)
	check(t, "one t|wo three", "ctrl-t ctrl-w", "one ^two| three")
	check(t, "a\n  b|c\nd", "ctrl-t ctrl-l", "a\n  ^bc|\nd")
	check(t, "a\n  b|c\nd", "alt-t alt-l", "a\n^  bc\n|d")
	check(t, "a\nb|\n\nc", "ctrl-t ctrl-p", "^a\nb|\n\nc")
end)

test("the nearest pair of brackets of any kind", function(t)
	check(t, "[(a|b)]", "ctrl-t ctrl-n", "[(^ab|)]")
	check(t, "[x (a) |y]", "alt-t alt-n", "^[x (a) y]|")
end)

test("a tag", function(t)
	check(t, "<p>hi|</p>", "ctrl-t ctrl-x", "<p>^hi|</p>")
	check(t, "<p>hi|</p>", "alt-t alt-x", "^<p>hi</p>|")
end)

test("an object's selection is carried on with shift", function(t)
	check(t, "f(a|b) c", "ctrl-t ctrl-r ctrl-L", "f(^ab)| c")
	check(t, "f(a|b) c", "ctrl-t ctrl-r alt-S ctrl-l", "f(ab^)| c")
end)

test("each cursor gets its own object", function(t)
	check(t, "(a|) (b|)", "ctrl-t ctrl-r", "(^a|) (^b|)")
end)

test("with no object around the cursor nothing changes", function(t)
	check(t, "a|b", "ctrl-t ctrl-r", "a|b")
end)

test("functions and syntax nodes come from the syntax tree", function(t)
	t:buffer("fn a() {\n    let x = 1|;\n}\nfn b() {}\n")
	greed.view():buffer():set_language("rust")
	greed.mode.set("flash")
	t:keys("alt-t alt-f")
	t:expect("^fn a() {\n    let x = 1;\n}|\nfn b() {}\n")
	t:buffer("fn a() { foo(ba|r) }")
	greed.view():buffer():set_language("rust")
	greed.mode.set("flash")
	t:keys("ctrl-t ctrl-o")
	t:expect("fn a() { foo(^bar|) }")
	t:keys("ctrl-[")
	t:expect("fn a() { foo^(bar)| }")
	t:keys("alt-[")
	t:expect("fn a() { foo(^bar|) }")
end)

test("surround adds, changes and deletes the pair around the selection", function(t)
	check(t, "a ^b| c", "ctrl-c e a (", "a ^(b)| c")
	check(t, "a (b|) c", "ctrl-c e r ( [", "a [b]| c")
	check(t, "a (b|) c", "ctrl-c e d (", "a b| c")
end)

local greed = require("@greed")
local test = require("@greed/test")

-- | is a range's head, ^ its anchor.
local function check(t: test.TestContext, before: string, keys: string, after: string)
	t:buffer(before)
	greed.mode.set("flash")
	t:keys(keys)
	t:expect(after)
end

test("plain motions move without selecting", function(t)
	check(t, "|one two three", "ctrl-w", "one |two three")
	check(t, "one two |three", "alt-w", "one |two three")
	check(t, "a|bc", "ctrl-l", "ab|c")
	check(t, "a|bc", "ctrl-h", "|abc")
	check(t, "a|bc", "alt-h", "ab|c")
	check(t, "ab|c", "alt-l", "a|bc")
	check(t, "one |two", "ctrl-e", "one two|")
	check(t, "one two|", "alt-e", "one| two")
	check(t, "  ab|c", "ctrl-a", "  |abc")
	check(t, "  |abc", "ctrl-a", "|  abc")
	check(t, "a|bc", "alt-a", "abc|")
end)

test("up and down keep the column, ctrl-j down and alt-j up", function(t)
	check(t, "ab|c\nd\nxyz", "ctrl-j ctrl-j", "abc\nd\nxy|z")
	check(t, "abc\nxy|z", "alt-j", "ab|c\nxyz")
	check(t, "abc\nxy|z", "ctrl-k", "ab|c\nxyz")
	check(t, "ab|c\nxyz", "alt-k", "abc\nxy|z")
end)

test("shift starts a selection, and again extends it", function(t)
	check(t, "|one two three", "ctrl-W", "^one |two three")
	check(t, "|one two three", "ctrl-W ctrl-W", "^one two |three")
	check(t, "one two |three", "alt-W", "one |two ^three")
	check(t, "|abc", "ctrl-L ctrl-L", "^ab|c")
	check(t, "ab|c\nxyz", "ctrl-J", "ab^c\nxy|z")
end)

test("with something selected, plain motions extend it", function(t)
	check(t, "|one two three", "ctrl-W ctrl-w", "^one two |three")
	check(t, "^one |two three", "ctrl-l", "^one t|wo three")
	check(t, "^ab|c\nxyz", "ctrl-j", "^abc\nxy|z")
end)

test("going back shrinks the selection, then crosses the anchor", function(t)
	check(t, "ab|cd", "ctrl-L ctrl-L alt-l", "ab^c|d")
	-- Back onto the anchor, and on past it the other way.
	check(t, "ab|cd", "ctrl-L alt-l", "ab|cd")
	check(t, "ab|cd", "ctrl-L alt-l alt-l", "a|b^cd")
	check(t, "one two |three", "ctrl-W alt-w alt-w", "one |two ^three")
end)

test("ctrl-space keeps selecting until pressed again, which collapses to the head", function(t)
	check(t, "|one two three", "ctrl-space ctrl-w", "^one |two three")
	check(t, "|one two three", "ctrl-space ctrl-w ctrl-w ctrl-l", "^one two t|hree")
	check(t, "|one two three", "ctrl-space ctrl-w ctrl-space", "one |two three")
	check(t, "|one two three", "ctrl-space ctrl-w ctrl-space ctrl-w", "one two |three")
end)

test("persistent selection crosses its anchor too", function(t)
	check(t, "ab|cd", "ctrl-space ctrl-l alt-l alt-l", "a|b^cd")
end)

test("shift-s collapses to the anchor, alt-shift-s to the head", function(t)
	check(t, "|one two three", "ctrl-W ctrl-W ctrl-S", "|one two three")
	check(t, "|one two three", "ctrl-W ctrl-W alt-S", "one two |three")
	check(t, "|one two three", "ctrl-W ctrl-S ctrl-w", "one |two three")
end)

test("esc drops the selection and persistent selection", function(t)
	check(t, "|one two", "ctrl-space ctrl-w esc ctrl-w", "one two|")
end)

test("typing replaces the selection and ends persistent selection", function(t)
	check(t, "|one two", "ctrl-W x", "x|two")
	check(t, "|one two", "ctrl-space x ctrl-w", "xone |two")
end)

test("plain keys type, punctuation and space included", function(t)
	check(t, "|", "h i space ; .", "hi ;.|")
	check(t, "a|", "enter b", "a\nb|")
end)

test("every cursor moves and selects on its own", function(t)
	check(t, "|ab |cd", "ctrl-l", "a|b c|d")
	check(t, "|ab cd |ef gh", "ctrl-W", "^ab |cd ^ef |gh")
end)

test("motions step over multi-byte characters whole", function(t)
	check(t, "|éü ok", "ctrl-L", "^é|ü ok")
	check(t, "|日本 語", "ctrl-w", "日本 |語")
	check(t, "|日本 語", "ctrl-e", "日本| 語")
end)

test("page and document motions select with shift", function(t)
	check(t, "a|b\ncd\nef", "alt-g G", "a^b\ncd\nef|")
	check(t, "ab\ncd\ne|f", "ctrl-g G", "|ab\ncd\ne^f")
	check(t, "ab\ncd\ne|f", "ctrl-g g", "|ab\ncd\nef")
end)
